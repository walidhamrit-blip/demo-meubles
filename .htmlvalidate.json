{
    "extends": ["html-validate:recommended", "html-validate:document"],
    "rules": {
        "require-sri": "off",
        "no-trailing-whitespace": "off",
        "long-title": "off",
        "wcag/h30": "error",
        "wcag/h32": "error",
        "wcag/h36": "error",
        "wcag/h37": "error",
        "wcag/h63": "error",
        "wcag/h67": "error",
        "wcag/h71": "error"
    }
}
