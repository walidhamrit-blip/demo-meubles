{
  "name": "maison-tripoli",
  "version": "1.0.0",
  "private": true,
  "description": "Site vitrine Maison Tripoli - mobilier d'art et haute ebenisterie",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./assets/css/main.css --minify",
    "dev": "tailwindcss -i ./src/input.css -o ./assets/css/main.css --watch",
    "icons": "node tools/build-icons.mjs",
    "brand": "python3 tools/build-brand-assets.py",
    "audit": "node tools/audit-seo.mjs",
    "test": "node tools/smoke-test.mjs",
    "validate": "html-validate index.html 404.html mentions-legales.html",
    "check": "npm run validate && npm run audit && npm run test",
    "serve": "python3 -m http.server 8080 --bind 0.0.0.0",
    "prepare-assets": "npm run icons && npm run build"
  },
  "devDependencies": {
    "html-validate": "^11.16.2",
    "jsdom": "^30.1.2",
    "lucide-static": "^1.52.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17"
  }
}
